__pycache__/
*.pyc
collected.json
digest.json
digest_*.html
latest.html
test_*.json
test_*.html
public/
# Runtime tracker data (generated by pipeline)
# kim_tracker.json, kcna_tracker.json, bp_tracker.json and feed_health.json
# are deliberately NOT ignored: the workflow commits them, so a cache miss
# falls back to the committed copy instead of an empty baseline
# (restore_state.py). gnews_cache.json is only a cache; losing it costs time.
gnews_cache.json
tension_tracker.json
.state-repo/
# metrics.jsonl is deliberately NOT ignored. It carries the per-run token
# counts and API cost, one line per run. Ignoring it meant the file lived
# only in the Actions cache, which GitHub evicts after seven days idle, so
# the spend history could vanish untouched. The commit step adds it.
weekly_*.html
weekly_*.json

# Generated by preview.py for the visual check; never committed.
preview.html
preview_print.html
